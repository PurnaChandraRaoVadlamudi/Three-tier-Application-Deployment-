pipeline {
    agent {label 'node'}

    stages {
        stage('Clean workspace') {
            steps {
                cleanWs()
            }
        }
        stage('code'){
            steps{
               git branch: 'test', url: 'https://github.com/PurnaChandraRaoVadlamudi/Three-tier-Application-Deployment-.git'
            }
        }
        stage('build'){
            steps{
                sh 'docker build -t appimage:v1 frontend'
                sh 'docker build -t dbimage:v1 backend'
            }
        }
        stage('run'){
            steps{
                sh 'docker run -itd --name appcont -p 3333:3000 appimage:v1'
                sh 'docker run -d --name db -p 3001:3000 dbimage:v1 '
            }
        }
    }
}

